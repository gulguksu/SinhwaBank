generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                  @id @default(autoincrement())
  username              String               @unique
  passwordHash          String
  name                  String
  isAdmin               Boolean              @default(false)
  job                   String?
  passwordHint          String?
  bankPaymentRequests   BankPaymentRequest[] @relation("BankPaymentRequestedBy")
  bankPaymentTargets    BankPaymentRequest[] @relation("BankPaymentTarget")
  policeFineRequests    PoliceFineRequest[]  @relation("PoliceFineRequestedBy")
  policeFineTargets     PoliceFineRequest[]  @relation("PoliceFineTarget")
  taxChangeRequests     TaxChangeRequest[]   @relation("TaxChangeRequestedBy")
  transactions          Transaction[]
  depositSubscriptions  DepositSubscription[]
  depositPayoutRequests DepositPayoutRequest[] @relation("BankerDepositPayoutRequests")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  amount      Int
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, type])
}

model GlobalState {
  id        Int @id @default(1)
  globalTax Int @default(0)
}

model TaxHistory {
  id           Int      @id @default(autoincrement())
  amountBefore Int
  amountAfter  Int
  diff         Int
  description  String
  createdAt    DateTime @default(now())
}

model TaxChangeRequest {
  id            Int      @id @default(autoincrement())
  requestedById Int
  newAmount     Int
  description   String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  requestedBy   User     @relation("TaxChangeRequestedBy", fields: [requestedById], references: [id])

  @@index([requestedById])
  @@index([status, createdAt])
}

model BankPaymentRequest {
  id            Int      @id @default(autoincrement())
  requestedById Int
  targetUserId  Int
  amount        Int
  description   String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  requestedBy   User     @relation("BankPaymentRequestedBy", fields: [requestedById], references: [id])
  target        User     @relation("BankPaymentTarget", fields: [targetUserId], references: [id])

  @@index([requestedById])
  @@index([targetUserId])
  @@index([status, createdAt])
}

model PoliceFineRequest {
  id              Int      @id @default(autoincrement())
  requestedById   Int
  targetUserId   Int
  amount          Int
  violationDetail String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  requestedBy     User     @relation("PoliceFineRequestedBy", fields: [requestedById], references: [id])
  target          User     @relation("PoliceFineTarget", fields: [targetUserId], references: [id])

  @@index([requestedById])
  @@index([targetUserId])
  @@index([status, createdAt])
}

model ShopItem {
  id    Int    @id @default(autoincrement())
  name  String
  price Int
  stock Int    @default(0)
  order Int    @default(0)
}

model DepositProduct {
  id            Int                 @id @default(autoincrement())
  name          String
  interestRate  Int                 // 퍼센트 단위 (예: 5, 15, 40)
  maturityWeeks Int                 // 만기 기간 (주 단위)
  isActive      Boolean             @default(true)
  order         Int                 @default(0)
  subscriptions DepositSubscription[]
}

model DepositSubscription {
  id            Int                 @id @default(autoincrement())
  userId        Int
  productId     Int
  principal     Int                 // 원금
  interestRate  Int                 // 가입 시점의 이자율
  maturityWeeks Int                 // 가입 시점의 만기 기간(주)
  startedAt     DateTime            @default(now())
  status        String              @default("ongoing") // ongoing, waiting_payout, cancelled, paid
  user          User                @relation(fields: [userId], references: [id])
  product       DepositProduct      @relation(fields: [productId], references: [id])
  payoutRequests DepositPayoutRequest[]

  @@index([userId])
  @@index([productId])
  @@index([userId, status, startedAt])
}

model DepositPayoutRequest {
  id             Int                  @id @default(autoincrement())
  bankerId       Int?
  subscriptionId Int
  amount         Int
  kind           String               // maturity | early_cancel
  status         String               @default("pending") // pending, approved
  createdAt      DateTime             @default(now())
  subscription   DepositSubscription  @relation(fields: [subscriptionId], references: [id])
  banker         User?                @relation("BankerDepositPayoutRequests", fields: [bankerId], references: [id])

  @@index([bankerId])
  @@index([subscriptionId])
  @@index([status, createdAt])
}
